# Copy this file to `.env` and fill in local secrets.
# Never commit real API keys or machine-specific secrets.

APP_NAME=chatbot_rag
ENVIRONMENT=local
CORS_ORIGINS=*

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m
LLM_TEMPERATURE=0.2
LLM_NUM_PREDICT=256
LLM_THINK=false

# 검색/로컬 저장소
CHROMA_PATH=./data/vector_store/chroma
CHROMA_COLLECTION=manual_documents
DATABASE_URL=sqlite:///./data/app.sqlite3
RAW_DATA_PATH=./data/raw
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=16
TOP_K=40

# 한국관광공사 OpenAPI
# 한국관광공사_국문 관광정보 서비스_GW
# https://www.data.go.kr/data/15101578/openapi.do
# 국문 관광정보 서비스_GW(KorService2) 호출용 인증키
TOUR_API_SERVICE_KEY=

# 한국관광공사_무장애 여행 정보
# https://www.data.go.kr/data/15101897/openapi.do
# 무장애 여행 정보(KorWithService2) 호출용 인증키
# 현재 공공데이터포털 인증키는 동일하지만, 서비스별 용도를 분리해 둔다.
TOUR_API_ACCESSIBLE_SERVICE_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_ACCESSIBLE_BASE_URL=https://apis.data.go.kr/B551011/KorWithService2
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=chatbot_rag
TOUR_API_TIMEOUT=20
TOUR_API_DAILY_ENDPOINT_LIMIT=1000
TOUR_API_USAGE_LOG_PATH=./data/generated/tour_api/usage/daily_usage.json

# TourAPI 원본 응답 SQLite 캐시
# - true이면 같은 후보/상세/지역코드 조회를 서버 재시작 뒤에도 재사용한다.
# - 서비스 인증키는 캐시 키와 저장 params에 넣지 않는다.
TOUR_API_RESPONSE_CACHE_ENABLED=true
TOUR_API_RESPONSE_CACHE_PATH=./data/generated/tour_api/live_response_cache.sqlite3

# 관광 응답 모드
# - TOURISM_LIVE_LOOKUP_ENABLED=true: 최신 자료 확인과 저장 자료 사용을 허용한다.
# - TOURISM_LIVE_LOOKUP_ENABLED=false: 최신 자료 확인을 끄고 준비된 자료만 사용한다.
# - TOURISM_LOOKUP_STRATEGY=cache_first: 기존 동작. 저장 자료와 준비 자료를 먼저 보고, 필요할 때 최신 자료를 확인한다.
# - TOURISM_LOOKUP_STRATEGY=live_update: 최신 자료를 먼저 확인하되 5초 안에 결과가 없으면 준비된 결과를 먼저 응답하고, 15초 안에 도착한 최신 결과는 다음 요청에서 승인 후 반영한다.
TOURISM_LIVE_LOOKUP_ENABLED=true
TOURISM_LOOKUP_STRATEGY=cache_first
TOURISM_LIVE_FIRST_WAIT_SECONDS=5
TOURISM_LIVE_BACKGROUND_TIMEOUT_SECONDS=15
TOURISM_LIVE_ROWS=10
TOURISM_LIVE_MAX_DETAIL_CALLS=10
TOURISM_LIVE_CACHE_PATH=./data/generated/tour_api/live_markdown
TOURISM_SAMPLE_PATH=./data/raw/tourism_accessible
TOURISM_REASONING_ASSIST_ENABLED=true
TOURISM_REASONING_ASSIST_MAX_CARDS=5

# 로컬 한국어 교정 모델.
# - FastAPI 서버 내부에서 로컬 파일만 읽어 실행한다.
# - 런타임에는 Hugging Face나 외부 교정 API를 호출하지 않는다.
# - RISKY_ONLY=true이면 깨끗한 입력은 ET5를 건너뛰고, 오타/무띄어쓰기 위험 입력만 교정 후보를 만든다.
# - 교정문은 원문 대체가 아니라 후보 입력이다. 원문도 항상 병렬로 해석한다.
TOURISM_KOREAN_CORRECTION_ENABLED=true
TOURISM_KOREAN_CORRECTION_PROVIDER=hf_seq2seq
TOURISM_KOREAN_CORRECTION_MODEL=./data/models/tourism_korean_corrector
TOURISM_KOREAN_CORRECTION_DEVICE=auto
TOURISM_KOREAN_CORRECTION_RISKY_ONLY=true
TOURISM_KOREAN_CORRECTION_ALLOW_DOWNLOAD=false
TOURISM_KOREAN_CORRECTION_MAX_CHARS=80
TOURISM_KOREAN_CORRECTION_MAX_LENGTH=128
TOURISM_KOREAN_CORRECTION_NUM_BEAMS=1

# 로컬 조건 라벨 Transformer.
# - rule/parser를 대체하지 않고 보조 신호로만 사용한다.
# - rule/parser가 약하거나 조건을 못 찾은 경우, 노이즈 입력, 어려운 의미 표현이 있을 때만 런타임 게이트가 호출한다.
# - 깨끗하고 조건이 명확한 입력은 속도와 안정성을 위해 RoBERTa를 호출하지 않는다.
# - 라벨이 충돌하거나 의도가 애매하면 추천을 단정하지 않고 추가질문으로 보낸다.
# - data/generated 아래 모델 산출물은 로컬 전용이며 git에 커밋하지 않는다.
# - fresh checkout에서는 로컬 모델 산출물이 없을 수 있으므로 기본값은 false로 둔다.
TOURISM_CONDITION_TRANSFORMER_ENABLED=false
TOURISM_CONDITION_TRANSFORMER_MODEL=./data/generated/tour_api/condition_transformer_residual_aug_e2_fast/model
TOURISM_CONDITION_TRANSFORMER_METRICS_PATH=./data/generated/tour_api/condition_transformer_residual_aug_e2_fast/metrics.json
TOURISM_CONDITION_TRANSFORMER_DEVICE=auto
TOURISM_CONDITION_TRANSFORMER_MAX_LENGTH=96

# 관광 질의-카드 이벤트 로그
# - JSONL 이벤트는 git ignore 대상인 data/generated 아래에 기록한다.
# - 메시지 원문은 기본적으로 저장하지 않는다.
TOURISM_QUERY_EVENT_LOG_ENABLED=true
TOURISM_QUERY_EVENT_LOG_INCLUDE_MESSAGE=false
TOURISM_QUERY_EVENT_LOG_PATH=./data/generated/tour_api/query_card_events.jsonl
